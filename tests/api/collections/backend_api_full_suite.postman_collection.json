        {
          "name": "Addresses - Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  var d = pm.response.json();",
                  "  if (d && d.id) pm.environment.set('addressId', d.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Nhà riêng\",\n  \"recipient_name\": \"Customer\",\n  \"phone\": \"0900000000\",\n  \"line1\": \"123 Đường ABC\",\n  \"ward\": \"Phường XYZ\",\n  \"district\": \"Ba Đình\",\n  \"province\": \"Thành phố Hà Nội\",\n  \"is_default\": true\n}"
            },
            "url": "{{baseUrl}}/addresses"
          }
        },
        { "name": "Addresses - Show", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": "{{baseUrl}}/addresses/{{addressId}}" } },
        {
          "name": "Addresses - Update",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"label\": \"Văn phòng\"\n}" },
            "url": "{{baseUrl}}/addresses/{{addressId}}"
          }
        },
        {
          "name": "Checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checkout status is 201', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "",
                  "pm.test('Checkout response is JSON', function () {",
                  "  var contentType = (pm.response.headers.get('Content-Type') || '').toLowerCase();",
                  "  pm.expect(contentType).to.include('application/json');",
                  "});",
                  "",
                  "var d = {};",
                  "try {",
                  "  d = pm.response.json();",
                  "} catch (e) {",
                  "  pm.test('Checkout body is valid JSON', function () {",
                  "    throw new Error('Response is not JSON. Possible redirect/fallback to frontend.');",
                  "  });",
                  "}",
                  "",
                  "var order = d && d.order ? d.order : null;",
                  "pm.test('Checkout returns order id', function () {",
                  "  pm.expect(order && order.id, 'Missing order.id').to.exist;",
                  "});",
                  "",
                  "if (order && order.id) pm.environment.set('orderId', order.id);",
                  "var items = (order && (order.order_items || order.orderItems)) || [];",
                  "if (Array.isArray(items) && items.length > 0 && items[0].id) {",
                  "  pm.environment.set('orderItemId', items[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fulfillment_method\": \"shipping\",\n  \"shipping_address_id\": {{addressId}},\n  \"weight_grams\": 15000,\n  \"tax_rate_basis_points\": 0,\n  \"payment_method\": \"sepay_qr\"\n}"
            },
            "url": "{{baseUrl}}/checkout"
          }
        },
